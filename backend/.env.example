# Copy to backend/.env. Leave OPENAI_API_KEY empty to run fully offline (deterministic fallbacks).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://genailab.tcs.in/
OPENAI_VERIFY_SSL=false
# Model names come from env only (CONTRIBUTING.md rule 10). Use models your account has access to.
OPENAI_MODEL_FAST=genailab-openai-gpt-5.6-luna
OPENAI_MODEL_SMART=genailab-openai-gpt-5.6-luna
# USD per 1M tokens, for /admin cost accounting
PRICE_FAST_IN=0.40
PRICE_FAST_OUT=1.60
PRICE_SMART_IN=2.00
PRICE_SMART_OUT=8.00
DATABASE_URL=sqlite:///./rootwise.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# OpenTelemetry traces + metrics + logs over OTLP/HTTP (OpenObserve by default; any OTLP backend works).
# Local OpenObserve: docker compose -f deploy/openobserve/docker-compose.yml up -d
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rootwise-backend
OTEL_ENVIRONMENT=dev
OTEL_EXPORTER_ENDPOINT=http://localhost:5080/api/default
OTEL_SAMPLE_RATIO=1.0
# OpenObserve root credentials (sent as HTTP Basic auth). Or set OTEL_HEADERS=Authorization=Basic <token>
OPENOBSERVE_USER=root@rootwise.local
OPENOBSERVE_PASSWORD=replace-me-in-local-env
OPENOBSERVE_UI_URL=http://localhost:5080
OPENOBSERVE_ORG=default
# Admin log store retention
LOG_RETENTION_DAYS=7
LOG_MAX_ROWS=50000
# Guardrails: cost cap per studio generation job, and rate limits (per minute)
STUDIO_MAX_TOKENS_PER_JOB=2500000
STUDIO_JOBS_PER_MINUTE=5
RATE_LIMIT_HINT_PER_MINUTE=20
RATE_LIMIT_LESSON_PER_MINUTE=10
# Feature flags
FLAG_SIM_ENDPOINT=true
FLAG_BOSS=true
FLAG_TEACH_BOT=true
FLAG_REPLAY=true
FLAG_HINTS=true
