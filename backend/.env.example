# Copy to backend/.env. Leave OPENAI_API_KEY empty to run fully offline (deterministic fallbacks).
OPENAI_API_KEY=
# Model names come from env only (CLAUDE.md rule 10). Use models your account has access to.
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_SMART=gpt-4.1
# USD per 1M tokens, for /admin cost accounting
PRICE_FAST_IN=0.40
PRICE_FAST_OUT=1.60
PRICE_SMART_IN=2.00
PRICE_SMART_OUT=8.00
DATABASE_URL=sqlite:///./rootwise.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional external tracing: langfuse | phoenix (requires that package installed)
TRACING_EXPORT=
# Feature flags
FLAG_SIM_ENDPOINT=true
FLAG_BOSS=true
FLAG_TEACH_BOT=true
FLAG_REPLAY=true
FLAG_HINTS=true
